<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ye background color daal do jo tumhare splash screen ka hai -->
    <!-- Example: Dark app → black, Light app → apna brand color -->
    <item android:drawable="@color/launch_background_color" />

    <!-- Yaha center mein logo dikhana ho toh uncomment kar do -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />   <!-- Ya apna custom logo daal do -->
    </item>

</layer-list>