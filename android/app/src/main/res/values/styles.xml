<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- YE WAHI HAI JO SPLASH SE PEHLE DIKHEGA (ISLIYE SABSE IMPORTANT) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Tumhara brand color ya image yaha dikhega, white bilkul nahi aayega -->
        <item name="android:windowBackground">@drawable/launch_background</item>

        <!-- Ye line white flash ko 100% block kar deti hai -->
        <item name="android:windowDisablePreview">true</item>

        <!-- Extra safety Android 12+ ke liye -->
        <item name="android:windowSplashScreenBackground">@color/launch_background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <!-- Ye theme Flutter engine start hone ke baad use hota hai -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background_color</item>
    </style>

</resources>